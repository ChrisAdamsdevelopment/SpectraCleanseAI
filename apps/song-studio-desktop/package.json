{
  "name": "song-studio-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Song Studio — desktop content studio for turning one song into promotional video assets.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:release": "node scripts/stage-ffmpeg.mjs && tsc && vite build",
    "stage:ffmpeg": "node scripts/stage-ffmpeg.mjs",
    "stage:ffmpeg:check": "node scripts/stage-ffmpeg.mjs --check",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "alpha:build": "tauri build",
    "alpha:config:test": "tsx scripts/release-config.test.mts",
    "updater:keygen": "tauri signer generate -w .tauri/songstudio-updater.key",
    "render:smoke": "tsx render-core/smoke.mts",
    "loop-core:smoke": "tsx src/project/loop-core-integrity.smoke.mts",
    "canvas:smoke": "tsx src/canvas/smoke.mts",
    "canvas:motion:test": "tsx src/canvas/motion-metrics.smoke.mts",
    "canvas:lab": "tsx src/canvas/canvas-lab.mts",
    "readiness:test": "tsx src/project/readiness.test.mts",
    "render-freshness:test": "tsx src/project/renderFreshness.test.mts",
    "direction:test": "tsx src/project/direction.test.mts",
    "director:generation:test": "tsx src/director/director-generation.test.mts",
    "director:model:test": "tsx src/director/director-model.test.mts",
    "director:logic:test": "tsx src/director/director-logic.test.mts",
    "director:assembly:smoke": "tsx render-core/director-assembly.smoke.mts",
    "director:artifacts:smoke": "tsx render-core/director-artifacts.smoke.mts",
    "app:settings:test": "tsx src/app/app-settings.test.mts",
    "app:security:test": "tsx src/app/security.test.mts",
    "app:recovery:test": "tsx src/app/recovery.test.mts",
    "app:diagnostics:test": "tsx src/app/diagnostics.test.mts",
    "grok:test": "tsx src/director/providers/grok.test.mts",
    "updater:test": "tsx src/app/updater.test.mts",
    "host:integration:test": "tsx src/director/host-integration.test.mts",
    "app:atomic:test": "tsx src/app/atomic-file.test.mts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "ffmpeg-static": "^5.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.3.5"
  }
}
