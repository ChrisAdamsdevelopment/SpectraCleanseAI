node_modules/
dist/
out/
*.mp4
*.mov
*.webm

# Rust / Tauri build output
src-tauri/target/
src-tauri/gen/

# FFmpeg sidecar staged from node_modules by scripts/stage-ffmpeg.mjs at build
# time (~79 MB). Never committed — CI and local builds regenerate it via
# `npm run stage:ffmpeg` (wired into build:release / beforeBuildCommand).
src-tauri/binaries/

# Updater signing keys — NEVER commit. Generated by `npm run updater:keygen`.
.tauri/
*.key
*.key.pub

# local synthetic test assets produced by render:smoke
render-core/.smoke-assets/

# generated mobile icon sets (desktop app does not need them committed)
src-tauri/icons/android/
src-tauri/icons/ios/
