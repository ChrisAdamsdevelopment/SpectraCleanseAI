# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Public app URL used by backend links / redirects
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Comma-separated CORS allowlist used by server
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─────────────────────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
DB_PATH=spectra.db

# ─────────────────────────────────────────────────────────────────────────────
# Billing (Stripe)
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=
ENABLE_MOCK_CHECKOUT=true

# ─────────────────────────────────────────────────────────────────────────────
# Gemini
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SMTP / Email delivery (verification + password reset)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# Feature flags (trust/compliance overhaul) — OFF by default
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated. Known: chain_of_custody, metadata_validation, release_readiness,
# platform_compliance, ai_disclosure, rights_verification. Unknown names are
# ignored. Leaving this empty keeps the app behaving exactly as the current
# production release. Phase B demo: FEATURES=metadata_validation,release_readiness
FEATURES=

# ─────────────────────────────────────────────────────────────────────────────
# Admin dashboard
# Static bearer token for /admin/* routes. Must be a strong random string
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# Never share this value or commit a real one.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Frontend build
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001

# Build-time mirror of FEATURES for the SPA. Optional — the SPA can also read
# enabled features at runtime from GET /api/features.
VITE_FEATURES=

# Production note:
# - SMTP/email delivery is required in production for verification/reset links.
# - In non-production, missing SMTP uses development fallback logging.
# - Never commit real SMTP or API credentials.
